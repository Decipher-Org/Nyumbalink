# NyumbaLink web client — environment
#
# Copy to `.env.local` and adjust. Everything in this file is compiled into the
# JavaScript bundle and is readable by anyone who loads the site, so it may hold
# public configuration only. Secrets (Resend API key, BETTER_AUTH_SECRET,
# DATABASE_URL) live in propertyHubBackend/.env and never here.

# Backend origin, without a trailing slash.
# Local development matches the backend's default PORT. For the production
# Netlify environment set this to https://api.nyumbalink.co.ke and redeploy.
VITE_API_URL=http://localhost:8080

# Firebase web configuration (Project settings → General → Your apps → Web app).
# These values are intentionally public browser configuration, not server secrets.
# Create a Web Push certificate in Project settings → Cloud Messaging to obtain
# the VAPID key. The backend's FCM service account stays in propertyHubBackend/.env.
VITE_FIREBASE_API_KEY=AIzaSyAavNmxsMRx6JL5QpNGvosa7L_h1OICQfg
VITE_FIREBASE_AUTH_DOMAIN=nyumbalink-f853f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nyumbalink-f853f
VITE_FIREBASE_STORAGE_BUCKET=nyumbalink-f853f.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=731096441081
VITE_FIREBASE_APP_ID=1:731096441081:web:9fb5728d34d36206f60228
VITE_FIREBASE_VAPID_KEY=BPF6938Kjrh1y0GpZZoz8WuiEFmnmDqDNiNG9AqqyB3Z1GPrsNy7SpCsWKLvmNCHJ5EFFrbbtiXyzBvht4_YaRk
