# NyumbaLink web client — environment
#
# Copy to `.env.local` and adjust. Everything in this file is compiled into the
# JavaScript bundle and is readable by anyone who loads the site, so it may hold
# public configuration only. Secrets (Resend API key, BETTER_AUTH_SECRET,
# DATABASE_URL) live in propertyHubBackend/.env and never here.

# Backend origin, without a trailing slash.
# Local development matches the backend's default PORT.
VITE_API_URL=http://localhost:8080
